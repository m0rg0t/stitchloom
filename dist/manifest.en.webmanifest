{
  "id": "./",
  "name": "Stitchloom — cross-stitch pattern from a photo",
  "short_name": "Stitchloom",
  "description": "Turns a photo into a cross-stitch pattern directly in your browser.",
  "lang": "en",
  "start_url": "./en/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#131718",
  "theme_color": "#131718",
  "categories": ["lifestyle", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "./en/",
      "accept": { "application/x-stitchloom+json": [".stitchloom"] }
    }
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
